#: main/i18n_messages.py:15
msgid "Enter the same password as before, for verification."
msgstr "Барои тасдиқ ҳамон рамзро бори дигар ворид кунед."

#: main/i18n_messages.py:16
msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "Ҳатмӣ. То 150 аломат. Танҳо ҳарфҳо, рақамҳо ва аломатҳои @/./+/-/_."

#: main/i18n_messages.py:17
msgid "Your password can’t be too similar to your other personal information."
msgstr "Рамзи шумо набояд ба маълумоти шахсии шумо хеле монанд бошад."

#: main/i18n_messages.py:18
msgid "Your password can’t be a commonly used password."
msgstr "Рамзи шумо набояд аз рамзҳои маъмул бошад."

#: main/i18n_messages.py:19
msgid "Your password can’t be entirely numeric."
msgstr "Рамзи шумо набояд танҳо аз рақамҳо иборат бошад."

#: main/i18n_messages.py:20
#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Рамз ба маълумоти «%(verbose_name)s» хеле монанд аст."

#: main/i18n_messages.py:21
msgid "This password is too common."
msgstr "Ин рамз хеле маъмул аст."

#: main/i18n_messages.py:22
msgid "This password is entirely numeric."
msgstr "Ин рамз танҳо аз рақамҳо иборат аст."

#: main/i18n_messages.py:23
msgid "The two password fields didn’t match."
msgstr "Рамзҳои воридшуда якхела нестанд."

#: main/i18n_messages.py:24
msgid "This account is inactive."
msgstr "Ин ҳисоб ғайрифаъол аст."

#: main/i18n_messages.py:25
#, python-format
msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"Лутфан, %(username)s ва рамзро дуруст ворид кунед. Ҳарфҳои калону хурд "
"метавонанд фарқ дошта бошанд."

#: main/i18n_messages.py:26
msgid "A user with that username already exists."
msgstr "Корбаре бо ин ном аллакай вуҷуд дорад."

#: main/i18n_messages.py:27
msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"Номи корбарро дуруст ворид кунед. Танҳо ҳарфҳо, рақамҳо ва аломатҳои @/./+/-/"
"_ иҷозат дода мешаванд."

#: main/i18n_messages.py:28
msgid "This field is required."
msgstr "Пур кардани ин майдон ҳатмист."

#: main/i18n_messages.py:29
msgid "This field cannot be blank."
msgstr "Ин майдон холӣ буда наметавонад."

#: main/i18n_messages.py:30
msgid "Enter a valid value."
msgstr "Қимати дуруст ворид кунед."

#: main/i18n_messages.py:31
msgid "Enter a valid email address."
msgstr "Суроғаи дурусти почтаи электрониро ворид кунед."

#: main/i18n_messages.py:32
msgid "Enter a valid date."
msgstr "Санаи дуруст ворид кунед."

#: main/i18n_messages.py:33
msgid "Enter a number."
msgstr "Рақам ворид кунед."

#: main/i18n_messages.py:34
msgid "Enter a whole number."
msgstr "Адади бутун ворид кунед."

#: main/i18n_messages.py:35
msgid "Enter a valid integer."
msgstr "Адади бутуни дуруст ворид кунед."

#: main/i18n_messages.py:36
msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Яке аз вариантҳои дастрасро интихоб кунед."

#: main/i18n_messages.py:37
#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr ""
"Варианти дурустро интихоб кунед. %(value)s дар байни вариантҳои дастрас нест."

#: main/i18n_messages.py:38
#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Ин қимат бояд аз %(limit_value)s кам набошад."

#: main/i18n_messages.py:39
#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Ин қимат бояд аз %(limit_value)s зиёд набошад."

#: main/i18n_messages.py:45
#, python-format
msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Рамзи шумо бояд на кам аз %(min_length)d аломат дошта бошад."
msgstr[1] "Рамзи шумо бояд на кам аз %(min_length)d аломат дошта бошад."

#: main/i18n_messages.py:46
#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural ""
"This password is too short. It must contain at least %d characters."
msgstr[0] "Ин рамз хеле кӯтоҳ аст. Он бояд на кам аз %d аломат дошта бошад."
msgstr[1] "Ин рамз хеле кӯтоҳ аст. Он бояд на кам аз %d аломат дошта бошад."

#: main/i18n_messages.py:47
#, python-format
msgid ""
"Ensure this value has at most %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at most %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Ин қимат бояд на бештар аз %(limit_value)d аломат дошта бошад (ҳоло "
"%(show_value)d аломат дорад)."
msgstr[1] ""
"Ин қимат бояд на бештар аз %(limit_value)d аломат дошта бошад (ҳоло "
"%(show_value)d аломат дорад)."

#: main/i18n_messages.py:48
#, python-format
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
msgid_plural ""
"Ensure this value has at least %(limit_value)d characters (it has "
"%(show_value)d)."
msgstr[0] ""
"Ин қимат бояд на кам аз %(limit_value)d аломат дошта бошад (ҳоло "
"%(show_value)d аломат дорад)."
msgstr[1] ""
"Ин қимат бояд на кам аз %(limit_value)d аломат дошта бошад (ҳоло "
"%(show_value)d аломат дорад)."

#: main/i18n_messages.py:49
#, python-format
msgid "Ensure that there are no more than %(max)s digit in total."
msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "Шумораи умумии рақамҳо набояд аз %(max)s зиёд бошад."
msgstr[1] "Шумораи умумии рақамҳо набояд аз %(max)s зиёд бошад."

#: main/i18n_messages.py:50
#, python-format
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "Шумораи рақамҳо пас аз вергул набояд аз %(max)s зиёд бошад."
msgstr[1] "Шумораи рақамҳо пас аз вергул набояд аз %(max)s зиёд бошад."

#: main/i18n_messages.py:51
#, python-format
msgid ""
"Ensure that there are no more than %(max)s digit before the decimal point."
msgid_plural ""
"Ensure that there are no more than %(max)s digits before the decimal point."
msgstr[0] "Шумораи рақамҳо пеш аз вергул набояд аз %(max)s зиёд бошад."
msgstr[1] "Шумораи рақамҳо пеш аз вергул набояд аз %(max)s зиёд бошад."

